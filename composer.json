    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "aws/aws-sdk-php": "^3.0",
    "phpmailer/phpmailer": "^7.0",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {"psr-4": {"Lab\\": "src/"}},
  "scripts": {"test": "php tests/run.php", "test:mysql": "php tests/mysql.php"},
